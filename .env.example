# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Domain(s) and/or server IP, comma separated
ALLOWED_HOSTS=example.uz,www.example.uz,127.0.0.1
# Full origins (with scheme) the forms are posted from
CSRF_TRUSTED_ORIGINS=https://example.uz,https://www.example.uz
# Admin panel path (keep it non-obvious)
ADMIN_URL=boshqaruv-7f3k/

# --- HTTPS (turn on after the SSL certificate is installed) ---
USE_HTTPS=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Reverse proxy ---
# true when running behind nginx (real client IP for the rate limiter)
TRUST_X_FORWARDED_FOR=true
# false: nginx serves /media/ itself (recommended)
SERVE_MEDIA=false

# --- Database (default: SQLite file db.sqlite3) ---
# DATABASE_URL=postgres://rezume:password@127.0.0.1:5432/rezume

# --- Contact form notifications ---
# Telegram: create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional e-mail copy of every message
CONTACT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Max contact messages per IP per window (seconds)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=600

LOG_LEVEL=INFO
